rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isReasonableSize();
    }

    match /article-covers/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isReasonableSize();
    }

    match /article-images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isReasonableSize();
    }
  }
}
