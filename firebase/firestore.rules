rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return request.auth.token.email == 'dhanushharidoss47@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Check if user document exists with admin role
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().role == 'admin')
        // OR the user has the admin email (bootstrap case)
        || isAdminEmail()
      );
    }

    function isPublishedArticle() {
      return resource.data.status == 'published';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Allow admin email user to create/update their own profile
      allow create: if isSignedIn() && request.auth.uid == userId && isAdminEmail();
      allow update: if isSignedIn() && request.auth.uid == userId && isAdminEmail();
      allow delete: if false;
    }

    match /articles/{articleId} {
      allow read: if isPublishedArticle() || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId == 'site' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
